# SV13 Survivor Database - example configuration
# Never commit a real Discord token.

DISCORD_TOKEN=
DISCORD_GUILD_ID=
OWNER_USER_ID=

# Local fallback/source. Railway currently keeps its persistent state under /data.
SV13_KNOWLEDGE_DIR=SV13_Knowledge/Latest

# Production remote knowledge source.
SV13_KNOWLEDGE_BASE_URL=https://sv13ext.com/knowledge
SV13_KNOWLEDGE_CACHE_DIR=data/knowledge-cache
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=20

STATE_DB_PATH=data/sv13_bot.sqlite3

AUTO_SETUP=false
AUTO_SYNC=true
AUTO_PUBLISH=false
SYNC_INTERVAL_SECONDS=300
AUTO_PUBLISH_BATCH_SIZE=25
AUTO_PUBLISH_MAX_BATCHES=20

PUBLIC_STATUSES=SV13AuthoredCandidate,ProjectIntegratedCandidate
WEB_BASE_URL=https://sv13ext.com
LOG_LEVEL=INFO

SV13_CATEGORY_NAME=SV13 • SURVIVOR DATABASE
TERMINAL_CHANNEL_NAME=database-terminal
INTEL_CHANNEL_NAME=intel-updates
ITEM_FORUM_NAME=item-index
CRAFTING_FORUM_NAME=crafting-manual
BUILDING_FORUM_NAME=construction-manual
FIELD_FORUM_NAME=field-manual
